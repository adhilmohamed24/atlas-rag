# Set these as Space secrets. The app reads environment variables, not this file.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Required to enable document changes and paid LLM requests.
ADMIN_TOKEN=
# Optional public sample-corpus LLM requests per UTC day, per process. 0 disables.
PUBLIC_LLM_DAILY_LIMIT=0
# Remote Qdrant recommended for durability across Space rebuilds.
QDRANT_URL=
QDRANT_API_KEY=
NOTION_TOKEN=
DATA_DIR=data
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
